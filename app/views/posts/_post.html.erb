<div class="post">
  <div class="profile">
    <img class="profile_image" src="<%= post.user.profile.profile_picture_url%>" alt="<%= post.user.profile.username%> profile picture">
    <div>
      <%= post.user.profile.username %> 
    </div>
    <div>
      <%= time_ago_in_words(post.created_at) %> ago
    </div>
    <div>Likes: <%= post.likes.count %></div>
  </div>
  <div class="content">
    <h1 class="title"><%= post.title %></h1> 
    <div class="divider"></div>
    <p><%= post.body %></p>
  </div>
</div>