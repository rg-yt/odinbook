<div class="post_container">
  <div class="banner">
    <h1>Odinbook</h1>
    <div class="banner_image">
      <img src="https://www.pngmart.com/files/23/Pompompurin-PNG-Photo.png" alt="">
      <div class="oval"></div>
    </div>
  </div>
  <%= turbo_frame_tag :new_post do %>
    Create a new Post to share with friends!~
    <%= button_to "New Post", new_post_path, method: :get %> 
  <% end %>
  <%= turbo_frame_tag :posts do %> 
    <%= render @posts %>
  <% end %>

</div>
